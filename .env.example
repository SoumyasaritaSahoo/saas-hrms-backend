# App
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=saas_hrms
POSTGRES_PASSWORD=saas_hrms_secret
POSTGRES_DB=saas_hrms
# Constructed from POSTGRES_* variables above — update if you change those values.
# Only used by sequelize-cli migrations/seeders (src/database/config/database.config.ts).
DATABASE_URL=postgresql://saas_hrms:saas_hrms_secret@localhost:5432/saas_hrms

# JWT (mobile/app clients)
JWT_SECRET=change_me_jwt_secret_32_chars_min

# Session (web clients)
SESSION_SECRET=change_me_session_secret_32_chars
SESSION_NAME=session
SESSION_MAX_AGE=86400000

# Frontend URLs (for password reset links & CORS)
FRONTEND_URL=http://localhost:3001
ADMIN_FRONTEND_URL=http://localhost:3002

# Mail (SMTP) — used by MailService for password reset emails
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="SaaS HRMS <no-reply@example.com>"

# Used by MailService's baseEmailTemplate to build absolute asset URLs (e.g. logo image)
APP_URL=http://localhost:3000
